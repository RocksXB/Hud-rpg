rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // The setup code performs only this authenticated, owner-scoped read.
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
    }

    // No other client access is introduced by this baseline configuration.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
