rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owns(uid) { return signedIn() && request.auth.uid == uid; }
    function admin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function validStats(stats) {
      return stats.keys().hasOnly(['str','agi','vit','int','dex','luk']) &&
        stats.str is int && stats.agi is int && stats.vit is int && stats.int is int && stats.dex is int && stats.luk is int &&
        stats.str >= 0 && stats.agi >= 0 && stats.vit >= 0 && stats.int >= 0 && stats.dex >= 0 && stats.luk >= 0;
    }
    function initialPlayer(uid) {
      return owns(uid) && request.resource.data.keys().hasOnly([
        'playerId','displayName','characterCreated','raceId','classId','level','xp','hp','maxHp','mp','maxMp','condition',
        'locationId','regionId','zoneType','guildId','partyId','activeTitleId','avatarUrl','appearance','stats','createdAt','updatedAt','schemaVersion'
      ]) && request.resource.data.playerId is string && request.resource.data.playerId.size() >= 3 && request.resource.data.playerId.size() <= 32 &&
        request.auth.token.email == request.resource.data.playerId + '@grpg.local' && request.resource.data.characterCreated == false &&
        request.resource.data.displayName == null && request.resource.data.raceId == null && request.resource.data.classId == null &&
        request.resource.data.level == 1 && request.resource.data.xp == 0 && request.resource.data.hp == 0 && request.resource.data.maxHp == 0 &&
        request.resource.data.mp == 0 && request.resource.data.maxMp == 0 && request.resource.data.condition == 'stable' &&
        request.resource.data.zoneType == 'safe' && validStats(request.resource.data.stats) && request.resource.data.schemaVersion == 1;
    }
    function validCharacterCreation() {
      return resource.data.characterCreated == false && request.resource.data.characterCreated == true &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName','raceId','classId','stats','hp','maxHp','mp','maxMp','characterCreated','updatedAt']) &&
        request.resource.data.displayName is string && request.resource.data.displayName.size() >= 2 && request.resource.data.displayName.size() <= 32 &&
        request.resource.data.raceId is string && request.resource.data.classId is string && validStats(request.resource.data.stats) &&
        request.resource.data.hp == request.resource.data.maxHp && request.resource.data.mp == request.resource.data.maxMp &&
        request.resource.data.maxHp > 0 && request.resource.data.maxMp > 0;
    }

    match /admins/{uid} { allow get: if owns(uid); allow list, create, update, delete: if false; }
    match /players/{uid} {
      allow read: if owns(uid) || admin();
      allow create: if initialPlayer(uid) || admin();
      allow update: if (owns(uid) && validCharacterCreation()) || admin();
      allow delete: if admin();

      match /inventory/{ownedItemId} {
        allow read: if owns(uid) || admin();
        allow update: if owns(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['equipped','equippedSlot']) &&
          request.resource.data.itemId == resource.data.itemId && request.resource.data.quantity == resource.data.quantity && request.resource.data.rarity == resource.data.rarity;
        allow create, delete: if admin();
      }
      match /skills/{id} { allow read: if owns(uid) || admin(); allow write: if admin(); }
      match /titles/{id} { allow read: if owns(uid) || admin(); allow write: if admin(); }
      match /quests/{id} { allow read: if owns(uid) || admin(); allow write: if admin(); }
      match /notifications/{id} {
        allow read: if owns(uid) || admin();
        allow update: if owns(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read','readAt']) && request.resource.data.read == true;
        allow create, delete: if admin();
      }
    }
    match /items/{id} { allow read: if signedIn(); allow write: if admin(); }
    match /itemRequests/{id} {
      allow create: if signedIn() && request.resource.data.requesterUid == request.auth.uid && request.resource.data.status == 'pending' &&
        request.resource.data.reviewedAt == null && request.resource.data.reviewedBy == null && request.resource.data.rejectionReason == null;
      allow read: if (signedIn() && resource.data.requesterUid == request.auth.uid) || admin();
      allow update, delete: if admin();
    }
    match /guilds/{guildId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.leaderUid == request.auth.uid && request.resource.data.status == 'pending' && request.resource.data.approvedAt == null && request.resource.data.approvedBy == null;
      allow update, delete: if admin();
      match /members/{uid} { allow read: if signedIn(); allow write: if admin(); }
      match /joinRequests/{uid} {
        allow read: if owns(uid) || admin() || (signedIn() && get(/databases/$(database)/documents/guilds/$(guildId)).data.leaderUid == request.auth.uid);
        allow create: if owns(uid) && request.resource.data.uid == request.auth.uid && request.resource.data.status == 'pending';
        allow delete: if owns(uid) || admin(); allow update: if admin();
      }
    }
    match /parties/{partyId} { allow read: if signedIn() && exists(/databases/$(database)/documents/parties/$(partyId)/members/$(request.auth.uid)); allow write: if admin(); match /members/{uid} { allow read: if owns(uid) || admin(); allow write: if admin(); } }
    match /systemAnnouncements/{id} { allow read: if signedIn(); allow write: if admin(); }
    match /{document=**} { allow read, write: if false; }
  }
}
